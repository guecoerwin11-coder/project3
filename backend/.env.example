DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/skillbridge"
JWT_PASS=change-me-to-a-long-random-string
PORT=4100
NODE_ENV=development

# AI career assistant (optional; leave AI_API_KEY empty to turn it off).
# Any OpenAI-compatible provider works: NaraRouter, OpenRouter, OpenAI...
# AI_BASE_URL is the provider's base URL ending in /v1 (copy it from the provider's docs).
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Automatic job sources (optional). Request a free key at https://jooble.org/api/about
JOOBLE_API_KEY=
# Set to off on extra web-only instances; exactly one instance should run sources and alerts
SCHEDULER=on
